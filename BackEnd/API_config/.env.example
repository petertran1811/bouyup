# BuoyUp v4 · cấu hình. Dùng:  cp .env.example .env  rồi điền các ô có dấu (*).
# File .env chứa bí mật: KHÔNG commit, KHÔNG gửi qua chat. .gitignore đã chặn.
# Docker đọc file này qua docker-compose.yml (env_file). Chạy không Docker: backend tự đọc
# BackEnd/API_config/.env (đổi chỗ bằng biến ENV_FILE).

# --- Môi trường ------------------------------------------------------------------------
# dev | demo | production. dev/demo: tạo sẵn tài khoản mẫu (mật khẩu BUOYUP_DEMO_PASSWORD),
# khóa demo của ngân hàng, nút mô phỏng tiền về. production: không có tài khoản mẫu.
APP_ENV=demo
LOG_LEVEL=INFO
# (*) Khóa HMAC của sổ cục bộ. Bắt buộc khi APP_ENV khác dev/test. Sinh:
#     python3 -c 'import secrets;print(secrets.token_hex(32))'
# Đổi khóa thì chuỗi cục bộ cũ không còn kiểm được: giữ cố định cho một cơ sở dữ liệu.
CREDIT_LEDGER_KEY=
BUOYUP_DEMO_PASSWORD=BuoyUp@2026
BUOYUP_SESSION_HOURS=12
# Origin được gọi API từ trình duyệt (JSON). Mặc định ["*"]; UI đi kèm cùng origin nên không cần đặt.
# CORS_ALLOW_ORIGINS=["https://ten-mien-cua-ban"]

# --- Cơ sở dữ liệu ----------------------------------------------------------------------
# Trong Docker luôn là sqlite:////data/buoyup.db (volume buoyup-data); docker-compose ghi đè.
# Chạy không Docker: đường dẫn tương đối tính từ thư mục bạn đứng khi chạy uvicorn.
DATABASE_URL=sqlite:///./buoyup.db

# --- Mô hình ngôn ngữ (LLM) --------------------------------------------------------------
# Tắt (false) thì mọi agent chạy đường cố định của code (template), hệ thống vẫn đủ chức năng.
LLM_ENABLED=true
# (*) Endpoint kiểu OpenAI (vLLM...). Có LLM_HOST + LLM_MODEL_NAME thì dùng endpoint này.
LLM_HOST=
LLM_PORT=
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Agent 3 có thể dùng mô hình khác trên cùng endpoint (để trống = như trên).
LLM_AGENT3_MODEL_NAME=
# Agent 3 phải chạy mô hình khác Agent 2 (rà soát 16/10/2026): ở APP_ENV=production, bật LLM mà hai tên trùng
# nhau thì server không khởi động. Đặt false chỉ khi chấp nhận rủi ro một mô hình tự phản biện chính nó.
AGENT3_REQUIRE_DISTINCT_MODEL=true

# Tiền hàng về tài khoản WeBank: WeBank gọi POST /v4/webank/inflows, ký HMAC-SHA256 thân request bằng khóa này
# (header X-WeBank-Signature). Sinh: python -c 'import secrets;print(secrets.token_hex(24))'
WEBANK_WEBHOOK_SECRET=
# Chỉ cho demo: autopilot đóng vai sàn quyết toán, mỗi N phút cộng một ngày doanh thu vào tài khoản WeBank của khoản vay.
PLATFORM_PAYOUT_FEED=false
PLATFORM_PAYOUT_MINUTES=5
# Chỉ cho demo: hồ sơ từ "Gian hàng mẫu" kết luận theo đường code, mô hình chỉ thêm cảnh báo (HANDOVER 16.4).
DEMO_SAMPLE_GUARD=true

# CCCD (BackEnd/src/CCCD): bước định danh cần ảnh mặt trước CCCD đã đọc bằng OCR (ảnh không được lưu).
CCCD_OCR_REQUIRED=true
# Kết nối cửa hàng (HANDOVER 16.7): hồ sơ vay chỉ tạo từ cửa hàng đã chứng minh là của người vay (OAuth của sàn,
# hoặc mã gửi tới số điện thoại đăng ký của cửa hàng). false chỉ dùng cho kiểm thử cũ.
SHOP_CONNECT_REQUIRED=true
SHOP_CONNECTION_TTL_DAYS=30
# URL công khai để sàn chuyển người dùng về sau khi cấp quyền (OAuth callback
# <base>/v4/shops/connect/oauth/<sàn>/callback). Trống = lấy theo request.
# SHOP_OAUTH_REDIRECT_BASE=https://ten-mien-cua-ban
# Khóa ứng dụng mở của từng sàn. Để trống = nút "Kết nối qua <sàn>" bị ẩn và API trả 503.
# Taobao và Tmall dùng chung 淘宝开放平台, nên TAOBAO_* phục vụ cả hai.
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_SERVICE_ID=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
JD_APP_KEY=
JD_APP_SECRET=
PINDUODUO_APP_KEY=
PINDUODUO_APP_SECRET=
KUAISHOU_APP_KEY=
KUAISHOU_APP_SECRET=
# Kế hoạch vay cần ô "Tôi cam đoan" (ghi lên chuỗi).
PLAN_DECLARATION_REQUIRED=true
# Ảnh chụp doanh thu người bán tải lên (cho cán bộ xem). Mặc định: <repo>/data/uploads
# UPLOAD_DIR=
# Dự phòng: Gemini (chỉ dùng khi không đặt LLM_HOST).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Chuỗi khối FISCO BCOS ------------------------------------------------------------------
# local  = sổ mô phỏng trong cơ sở dữ liệu (không cần mạng)
# remote = dịch vụ chuỗi của team (giải ngân, anchor, danh mục ngân hàng thật)
BUOYUP_CHAIN_BACKEND=remote
BUOYUP_CHAIN_URL=https://fs.buoyup.app
BUOYUP_CHAIN_TOKEN=
BUOYUP_CHAIN_TIMEOUT_SECONDS=15

# --- Agent 4 / 5 tự chạy ----------------------------------------------------------------
BUOYUP_AUTOPILOT=true
BUOYUP_AGENT4_INTERVAL_SECONDS=300
BUOYUP_AGENT5_INTERVAL_SECONDS=21600
# Agent 5 lập báo cáo cho người bán (tháng / quý / năm / tất toán / nhắc đăng ký): chu kỳ tìm báo cáo đến hạn (giây)
BUOYUP_REPORTS_INTERVAL_SECONDS=3600
# Agent 5 không đề xuất đổi hệ số thận trọng khi một ngành có dưới chừng này mẫu (đặc tả: 30).
# Mẫu kiểm định ngược tổng hợp của demo có 20 dòng: đặt 20 chỉ để trình diễn luồng đề xuất (ghi rõ "mẫu tổng hợp").
BUOYUP_AGENT5_MIN_SAMPLE=30

# --- FATE (để trống = điểm liên ngân hàng từ dữ liệu mẫu) -----------------------------------
FATE_URL=

# --- Xác thực khuôn mặt (BackEnd/src/Reid, InsightFace buffalo_l) ------------------------------
# Mô hình tự tải về <FACE_MODEL_ROOT>/models/buffalo_l lần đầu (~330 MB). Mặc định: BackEnd/src/Reid
# và BackEnd/src/Reid/data (Docker: /data/insightface, /data/faces). Ngưỡng cosine ArcFace.
FACE_AUTH_ENABLED=true
FACE_MATCH_THRESHOLD=0.45
FACE_SAVE_CROPS=true

# Chế độ thực thi chỉ cho phép mock (giá trị khác: server không khởi động).
EXECUTION_MODE=mock

# Law retrieval (RAG) for Agent 3. Without fastembed or the model, search is lexical only (BM25).
# Model files (~2.2 GB for e5-large) and passage vectors are cached here; build them ahead of time with
# BackEnd/src/scripts/build_rag_index.py. BUOYUP_RAG_DENSE=0 turns the embedding side off.
BUOYUP_RAG_CACHE=../../data/rag-cache
BUOYUP_RAG_MODEL=intfloat/multilingual-e5-large
BUOYUP_RAG_DENSE=1
